<style is:global>
  :root {
    --cs-accent: #1a1a1a;
    --cs-accent-light: #f5f4f0;
    --cs-tag-bg: #efefec;
    --cs-tag-color: #444;
    --cs-border: #e0dfd9;
    --cs-muted: #777;
    --cs-good: #1a7a4a;
    --cs-good-bg: #edfaf3;
    --cs-bad: #a0291a;
    --cs-bad-bg: #fdf0ee;
  }

  .cs-hero,
  .cs-section {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .cs-figure {
    max-width: 900px;
    margin: 2.5rem auto;
    padding: 0 1.5rem;
  }
  .cs-figure img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--cs-border);
  }
  .cs-figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--cs-muted);
    text-align: center;
  }
  .cs-figure--full {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 0;
  }
  .cs-figure--full img { border-radius: 0; border: none; box-shadow: none; background: none; }

  .cs-hero__meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .cs-tag {
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    background: var(--cs-tag-bg);
    color: var(--cs-tag-color);
    border-radius: 999px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .cs-hero__title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
    font-weight: 700;
  }
  .cs-hero__title em {
    font-style: normal;
    opacity: 0.5;
  }
  .cs-hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #444;
    margin-bottom: 2.5rem;
    max-width: 60ch;
  }
  .cs-hero__specs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--cs-border);
  }
  .cs-spec__label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cs-muted);
    margin-bottom: 0.3rem;
    font-weight: 600;
  }
  .cs-spec__value { font-size: 0.9rem; line-height: 1.5; }

  .cs-section__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cs-muted);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .cs-section__title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.75rem;
  }
  .cs-section--closing {
    border-top: 1px solid var(--cs-border);
    padding-top: 5rem;
  }

  .cs-prose p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #333;
    margin-bottom: 1.25rem;
    max-width: 65ch;
  }
  .cs-prose p:last-child { margin-bottom: 0; }
  .cs-prose--mt { margin-top: 2rem; }
  .cs-prose--large p { font-size: 1.15rem; line-height: 1.8; }

  .cs-findings {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .cs-finding {
    background: var(--cs-accent-light);
    border-left: 3px solid #ccc;
    padding: 1.25rem 1.25rem 1rem;
    margin: 0;
    border-radius: 0 6px 6px 0;
  }
  .cs-finding p {
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 0.6rem;
    color: #222;
  }
  .cs-finding cite {
    font-size: 0.75rem;
    color: var(--cs-muted);
    font-style: normal;
  }

  .cs-highlight-block {
    background: var(--cs-accent);
    color: #fff;
    padding: 2.5rem;
    border-radius: 10px;
    margin: 2.5rem 0;
  }
  .cs-highlight-block__question {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .cs-highlight-block__desc {
    font-size: 1rem;
    opacity: 0.75;
    line-height: 1.6;
  }

  .cs-principles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .cs-principle { border-top: 2px solid var(--cs-accent); padding-top: 1rem; }
  .cs-principle__num {
    font-size: 0.75rem;
    color: var(--cs-muted);
    font-weight: 600;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .cs-principle__title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .cs-principle__desc { font-size: 0.9rem; color: #555; line-height: 1.6; }

  .cs-layers { margin-top: 2rem; display: flex; flex-direction: column; gap: 0; }
  .cs-layer {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--cs-border);
    border-radius: 8px;
    margin-bottom: 0.5rem;
    background: #fafaf8;
  }
  .cs-layer--connector {
    background: transparent;
    border: none;
    padding: 0 1.25rem;
    font-size: 1.2rem;
    color: var(--cs-muted);
    align-items: center;
  }
  .cs-layer__badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    background: var(--cs-accent);
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
    margin-top: 0.15rem;
  }
  .cs-layer__content h4 { font-weight: 700; margin-bottom: 0.25rem; font-size: 1rem; }
  .cs-layer__content p { font-size: 0.88rem; color: #555; line-height: 1.55; margin: 0; }

  .cs-token-levels { margin-top: 2rem; }
  .cs-token-level { border-top: 1px solid var(--cs-border); padding: 1.75rem 0; }
  .cs-token-level__header { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.75rem; }
  .cs-token-level__num { font-size: 0.75rem; color: var(--cs-muted); font-weight: 600; }
  .cs-token-level h3 { font-size: 1.1rem; font-weight: 700; }
  .cs-token-level p { font-size: 0.95rem; color: #444; line-height: 1.65; max-width: 60ch; margin-bottom: 1rem; }
  .cs-token-example { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .cs-token-example code {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    background: var(--cs-tag-bg);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    color: #333;
  }

  .cs-component-pillars {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  .cs-pillar { border: 1px solid var(--cs-border); border-radius: 8px; padding: 1.5rem; }
  .cs-pillar__title { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .cs-pillar__desc { font-size: 0.88rem; color: #555; line-height: 1.6; }

  .cs-writing-patterns { display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem; }
  .cs-pattern { border: 1px solid var(--cs-border); border-radius: 8px; overflow: hidden; }
  .cs-pattern__title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--cs-border);
    background: #fafaf8;
  }
  .cs-pattern__comparison { display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 520px) { .cs-pattern__comparison { grid-template-columns: 1fr; } }
  .cs-pattern__bad, .cs-pattern__good { padding: 1.25rem; }
  .cs-pattern__bad { background: var(--cs-bad-bg); border-right: 1px solid var(--cs-border); }
  .cs-pattern__good { background: var(--cs-good-bg); }
  .cs-pattern__badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    margin-bottom: 0.6rem;
  }
  .cs-pattern__badge--bad { background: var(--cs-bad); color: #fff; }
  .cs-pattern__badge--good { background: var(--cs-good); color: #fff; }
  .cs-pattern__bad p, .cs-pattern__good p { font-size: 0.95rem; line-height: 1.5; margin: 0; }
  .cs-pattern__reason {
    font-size: 0.82rem;
    color: var(--cs-muted);
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--cs-border);
    line-height: 1.55;
    margin: 0;
    background: #fafaf8;
  }

  .cs-callout {
    border-left: 4px solid var(--cs-accent);
    padding: 1.25rem 1.5rem;
    background: var(--cs-accent-light);
    border-radius: 0 8px 8px 0;
    margin: 2rem 0;
  }
  .cs-callout p { font-size: 0.95rem; line-height: 1.65; margin: 0; color: #222; }

  .cs-timeline {
    position: relative;
    margin-top: 2rem;
    padding-left: 2rem;
    border-left: 2px solid var(--cs-border);
  }
  .cs-timeline__item { position: relative; padding-bottom: 2rem; }
  .cs-timeline__item:last-child { padding-bottom: 0; }
  .cs-timeline__marker {
    position: absolute;
    left: calc(-2rem - 5px);
    top: 0.35rem;
    width: 10px;
    height: 10px;
    background: var(--cs-accent);
    border-radius: 50%;
  }
  .cs-timeline__content h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; }
  .cs-timeline__content p { font-size: 0.9rem; color: #555; line-height: 1.6; margin: 0; }

  .cs-outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .cs-outcome { padding: 1.5rem; border: 1px solid var(--cs-border); border-radius: 8px; background: #fafaf8; }
  .cs-outcome h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
  .cs-outcome p { font-size: 0.85rem; color: #555; line-height: 1.6; margin: 0; }

  .cs-figure--mt { margin-top: 2rem; }

  .cs-subsection-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 2.5rem 0 1.25rem;
  }

  .cs-layer__badge--1 { background: #fdf0ee; color: #a0291a; }
  .cs-layer__badge--2 { background: #fef9ec; color: #8a6000; }
  .cs-layer__badge--3 { background: #edf7ff; color: #1a5a8a; }
  .cs-layer__badge--4 { background: #f0f0fe; color: #4a4a9a; }
  .cs-layer__badge--5 { background: var(--cs-accent-light); color: var(--cs-muted); }

  .cs-outcome__icon { font-size: 1.4rem; display: block; margin-bottom: 0.75rem; }

  .cs-arch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.5rem auto;
    max-width: 900px;
    padding: 0 1.5rem;
  }
  .cs-arch-item { margin: 0; }
  .cs-arch-item img {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--cs-border);
    display: block;
  }

  .marquee-wrapper {
    width: calc(100% + 300px);
    margin: 2rem -150px;
    overflow: hidden;
    border-radius: 12px;
  }
  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
  }
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .marquee-slide {
    flex-shrink: 0;
    width: clamp(434px, 50vw, 686px);
  }
  .marquee-slide img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--cs-border);
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    display: block;
    background: #fff;
  }

  .cs-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  @media (max-width: 600px) { .cs-comparison { grid-template-columns: 1fr; } }
  .cs-comparison__item figure { margin: 0 0 0.75rem; }
  .cs-comparison__item img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--cs-border);
    display: block;
  }
  .cs-comparison__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .cs-comparison__label--before { background: var(--cs-bad-bg); color: var(--cs-bad); }
  .cs-comparison__label--after { background: var(--cs-good-bg); color: var(--cs-good); }
  .cs-comparison__desc { font-size: 0.85rem; line-height: 1.6; color: #555; }

  .cs-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  @media (max-width: 560px) { .cs-methods { grid-template-columns: 1fr; } }
  .cs-method { border: 1px solid var(--cs-border); border-radius: 8px; padding: 1.5rem; background: #fafaf8; }
  .cs-method__title { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.6rem; }
  .cs-method__desc { font-size: 0.88rem; color: #555; line-height: 1.65; }

  @media (prefers-color-scheme: dark) {
    :root {
      --cs-accent: #f0efe9;
      --cs-accent-light: #1e1e1c;
      --cs-tag-bg: #2a2a28;
      --cs-tag-color: #bbb;
      --cs-border: #2e2e2c;
      --cs-muted: #888;
      --cs-good-bg: #0f2a1c;
      --cs-bad-bg: #2a1010;
    }
    .cs-hero__subtitle, .cs-prose p { color: #bbb; }
    .cs-highlight-block { background: #f0efe9; color: #111; }
    .cs-layer, .cs-pillar, .cs-outcome, .cs-method { background: #1a1a18; }
    .cs-pattern__title, .cs-pattern__reason, .cs-callout, .cs-finding { background: #1a1a18; }
    .cs-layer__badge { background: #f0efe9; color: #111; }
    .cs-layer__badge--5 { background: #2a2a28; }
    .cs-token-example code { background: #2a2a28; color: #ddd; }
    .cs-comparison__desc, .cs-method__desc, .cs-layer__content p { color: #888; }
  }
</style>

